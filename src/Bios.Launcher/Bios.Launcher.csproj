<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Debug runs from a terminal and needs console stdout/stderr (NLog lines,
         exception dumps); the WinExe GUI subsystem detaches from the parent
         console and swallows them. -->
    <!-- See https://learn.microsoft.com/windows/console/console-allocation-policy -->
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <!-- Release ships as the windowed app. -->
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Bios.Launcher</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bios.Core\Bios.Core.csproj" />
    <ProjectReference Include="..\Bios.Data\Bios.Data.csproj" />
    <ProjectReference Include="..\Bios.Platform\Bios.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
