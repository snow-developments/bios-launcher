{
  "name": "BIOS Launcher",
  "version": "0.1.0",
  "description": "PS2 BIOS main-menu visual tokens for the launcher shell.",
  "colors": {
    "void": "#000000",
    "ring.core": "#eaf4ff",
    "ring.glow": "#7cc6ff",
    "ring.arc": "#2c4c7a",
    "menu.active": "#3aa2ff",
    "menu.idle": "#6b6b6b",
    "hint": "#8a8a8a",
    "tile.line": "#23364f",
    "glyph.cross": "#6fb2ff",
    "glyph.triangle": "#74e08f"
  },
  "typography": {
    "family": "\"Trebuchet MS\", \"Segoe UI\", sans-serif",
    "body": "16px",
    "menu": "clamp(24px, 3vw, 34px)",
    "hint": "clamp(13px, 1.5vw, 16px)"
  },
  "spacing": {
    "base": "4px",
    "scale": ["8px", "12px", "16px", "24px"]
  },
  "interaction": {
    "keyboard": ["ArrowUp", "ArrowDown", "Enter"],
    "gamepad": ["DPadUp", "DPadDown", "Cross"],
    "hints": ["✕ Enter", "△ Version"]
  }
}
