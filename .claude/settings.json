{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-read --allow-run --allow-env .claude/hooks/cite-check-stop.ts",
            "timeout": 30,
            "statusMessage": "cite-check: scanning changed files"
          }
        ]
      }
    ]
  }
}
